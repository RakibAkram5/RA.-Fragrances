# ─────────────────────────────────────────────────────────────
# RA Fragrances — environment configuration
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# Standard PostgreSQL connection string. Locally this points at the
# bundled PGlite socket server (a real PostgreSQL wire-protocol server
# backed by a WASM PostgreSQL engine — no external install required).
# In production, point this at your managed PostgreSQL instance.
DATABASE_URL="postgresql://ra:ra_local_dev_secret@127.0.0.1:5432/ra"
# Port the local PGlite socket server listens on.
DB_PORT=5432
# Where PGlite persists its data files (local development only).
DB_DATA_DIR=".data/pglite"

# ── Authentication ───────────────────────────────────────────
# Long, random secret used to derive session/token signing keys.
# Generate with: openssl rand -hex 32
AUTH_SECRET=""
SESSION_COOKIE_NAME="ra_session"
# Customer session lifetime (days)
SESSION_MAX_AGE_DAYS=30
# Admin session lifetime (hours)
ADMIN_SESSION_MAX_AGE_HOURS=8
# bcrypt work factor (10 for dev, 12+ recommended for production)
PASSWORD_HASH_COST=10

# ── Application ──────────────────────────────────────────────
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Storage (product images) ─────────────────────────────────
# "local" (filesystem) or "s3"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="storage/uploads"
# S3 credentials (only used when STORAGE_DRIVER=s3)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# ── Email ─────────────────────────────────────────────────────
# "console" (logs to server output + a dev-only outbox) or "smtp"
EMAIL_DRIVER="console"
EMAIL_FROM="RA Fragrances <no-reply@ra-fragrances.pk>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false

# ── Payments (future online gateways) ────────────────────────
# "cod" is fully implemented. Other drivers are isolated stubs
# behind the PaymentProvider interface until credentials are added.
PAYMENT_DRIVER="cod"
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGERITY_SALT=""

# ── Rate limiting (per-instance in-memory; swap for Redis in prod) ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ── Security / misc ───────────────────────────────────────────
# Enable the dev-only email outbox endpoint (only works when NODE_ENV != production)
ENABLE_DEV_OUTBOX=true
